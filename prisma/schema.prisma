// Prisma schema — base de datos de usuarios y roles del dashboard.
// Las tablas Account/Session/VerificationToken siguen la forma que espera
// el adapter de Prisma de Auth.js/NextAuth (login por email/contraseña).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  COMMENTER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(COMMENTER)
  /// Mail de destino donde esta persona recibe notificaciones (comentario
  /// nuevo, aprobación) — obligatorio para usuarios nuevos (ver createUser en
  /// usuarios/actions.ts). Separado de `email` (el de acceso/login) a
  /// propósito: no siempre coinciden, ver getAdminEmail() en site-settings.ts.
  notifyEmail   String
  /// Hash bcrypt — nunca la contraseña en texto plano. Opcional a nivel de
  /// fila: un Admin puede crear el usuario y cargarle la contraseña después.
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  pushSubscriptions PushSubscription[]
  moodboardSessions MoodboardSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Fila única (id fijo) con la personalización de marca de todo el
/// dashboard — editable solo por un Administrador. Cada campo es opcional
/// (null = usar el default de la marca actual, ver DEFAULT_BRAND en
/// src/lib/dashboard/site-settings.ts) para que un deployment nuevo (otra
/// cuenta, otra base de datos) solo tenga que cargar los suyos.
model SiteSettings {
  id                 String   @id @default("singleton")

  /// Nombre visible en Topbar, login, título de pestaña y placeholder de arte.
  brandName          String?
  /// Colores de marca — sobreescriben --color-brand-blue/-blue-700/-red en
  /// tiempo de ejecución (ver layout.tsx), sin tocar ninguna clase Tailwind.
  brandColorPrimary     String?
  brandColorPrimaryDark String?
  brandColorAccent      String?
  /// Handle mostrado en el preview de Instagram (nueva-propuesta).
  instagramHandle       String?

  /// Remitente del correo de notificación de comentarios (Gmail SMTP).
  senderEmail        String?  @db.Text
  /// Destinatario(s) de la notificación de comentarios nuevos (email).
  commentNotifyTo    String?  @db.Text
  commentNotifyCc    String?  @db.Text
  /// Email del usuario que debe recibir el push de "comentario nuevo"/
  /// "post aprobado" (ver sendPushToEmail en notify-push.ts) — a diferencia
  /// de commentNotifyTo (mail), esto sí depende de que ese usuario exista
  /// y tenga una PushSubscription (ver User.pushSubscriptions).
  pushNotifyTo       String?  @db.Text

  loginBackgroundUrl String?  @db.Text
  loginLogoUrl       String?  @db.Text

  /// Lista editable de pilares de contenido (ver Proposal.contentPillar) —
  /// null/vacío usa DEFAULT_BRAND.contentPillars en brand-defaults.ts.
  contentPillars   String[] @default([])

  updatedAt          DateTime @updatedAt
}

/// Propuesta de contenido — antes vivía entera en localStorage (ver
/// decisión del 2026-07-23 en el comentario de src/lib/dashboard/storage.ts,
/// ya migrado). `format`/`status` quedan como String simple (no enum) a
/// propósito: coinciden letra por letra con los union types de
/// src/types/dashboard.ts, así toda la lógica de estilos/íconos ya escrita
/// (toneHex, statusPillStyle, fmtShort, isVerticalFormat) sigue funcionando
/// sin tocar un mapeo enum↔string en cada lugar que la usa.
model Proposal {
  id        String   @id @default(cuid())
  /// ISO yyyy-mm-dd — string, no DateTime, para no romper las comparaciones
  /// lexicográficas (`p.date >= start`) que ya usa proposalsInPeriod().
  date      String
  time      String
  network   String
  format    String
  status    String
  title     String
  /// Caption vigente = espejo de la alternativa elegida en
  /// ProposalCaptionOption (ver syncSelectedCaption). Se mantiene como campo
  /// propio, y no derivado de la relación, porque es lo que consumen el
  /// título, las versiones, el preview, el export y las notificaciones.
  caption   String   @db.Text
  hashtags  String   @db.Text
  artN      Int      @default(1)
  /// URLs de artes — o bien rutas estáticas (contenido semilla) o data URLs
  /// base64 (subidas desde ArtUploadZone). Igual que antes de la migración;
  /// pasar a un storage real de archivos queda fuera de este cambio.
  images    String[] @default([])
  /// Solo Reels: portada va en `images[0]`, el video acá.
  video     String?  @db.Text
  aspect    String?
  dim       String?
  /// Aprobación por departamento (1 casilla fija, "Jun", ver CaptionPanel) —
  /// el insumo real de `computeProposalStatus` en vez del `status` de arriba.
  departmentApprovals Boolean[] @default([false])
  /// Recordatorios de publicación (ver /api/cron/reminders) — evitan mandar
  /// el mismo push dos veces si el cron corre de nuevo antes de que cambie
  /// nada. reminderSentT60 = aviso de "falta 1 hora"; reminderSentT0 = aviso
  /// de "es la hora".
  reminderSentT60 Boolean @default(false)
  reminderSentT0  Boolean @default(false)
  /// Recordatorio de vencimiento de aprobación (ficha 3) — mismo criterio de
  /// idempotencia que los de arriba, para no reenviar en cada corrida del cron.
  approvalReminderSent Boolean @default(false)
  /// Pilar de contenido (ficha 2) — string libre validado en el server contra
  /// SiteSettings.contentPillars/DEFAULT_BRAND; null = sin categorizar,
  /// a propósito, para no forzar una migración retroactiva.
  contentPillar String?
  /// Aprobación invalidada por una edición posterior (ficha 1) — texto
  /// legible ("Aprobación invalidada: ..."), no un booleano, porque
  /// computeProposalStatus lo usa tanto para decidir el estado como para
  /// mostrarlo. Se limpia (null) apenas se vuelve a aprobar.
  approvalInvalidatedReason String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ProposalComment[]
  versions ProposalVersion[]
  captionOptions ProposalCaptionOption[]
  musicOptions   ProposalMusicOption[]

  @@index([date])
}

/// Snapshot del caption/media *antes* de cada edición sobre una propuesta
/// (ficha 5) — updateProposal() en proposals-actions.ts crea uno de estos
/// con el valor viejo antes de sobreescribir, y poda a las últimas
/// PROPOSAL_VERSION_LIMIT (ver proposals.ts) por propuesta.
model ProposalVersion {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  caption    String   @db.Text
  images     String[] @default([])
  video      String?  @db.Text
  editedBy   String
  createdAt  DateTime @default(now())

  @@index([proposalId])
}

model ProposalComment {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// "general" o el índice del arte (como string) al que aplica.
  scope      String   @default("general")
  author     String
  text       String   @db.Text
  /// Capturas de pantalla adjuntas al comentario — data URLs base64, mismo
  /// criterio que Proposal.images.
  images     String[] @default([])
  avatarBg   String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([proposalId])
}

/// Tablero de referencias visuales del Admin — uso personal, previo a que
/// una idea se convierta en Propuesta. A diferencia de Proposal (que pasa por
/// aprobación del cliente), esto no lo ve nadie más: la sección entera está
/// gateada a rol ADMIN, y cada sesión además guarda su `ownerId`.
model MoodboardSession {
  id         String    @id @default(cuid())
  name       String
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Opcional: para qué tanda de contenido es esta sesión (solo informativo).
  targetDate DateTime?
  /// null = activa. Archivar en vez de borrar: el material de referencia
  /// sirve de contexto histórico aunque la tanda ya se haya publicado.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  elements MoodboardElement[]

  @@index([ownerId])
}

/// Un objeto suelto del canvas libre. Posición y tamaño van en columnas
/// planas (no un JSON `position`/`size`) a propósito: al arrastrar se guarda
/// solo x/y con debounce, y un update parcial de columnas es más barato que
/// leer-modificar-escribir un blob JSON entero.
model MoodboardElement {
  id        String           @id @default(cuid())
  sessionId String
  session   MoodboardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "image" | "video" | "video-embed" | "text-note" | "text-panel" — String
  /// simple, mismo criterio que Proposal.format: coincide letra por letra con
  /// el union type de src/types/moodboard.ts, sin mapeo enum↔string en cada
  /// lectura.
  type      String
  /// Coordenadas del canvas (no de pantalla) — el pan/zoom de la vista no las
  /// toca, así el tablero se ve igual en cualquier tamaño de ventana.
  x         Float
  y         Float
  width     Float
  height    Float
  /// Orden de apilado cuando dos elementos se superponen.
  zIndex    Int              @default(0)
  rotation  Float            @default(0)

  /// image/video: URL en Blob Storage. video-embed: la URL pegada (Instagram,
  /// TikTok, YouTube). text-note usa `text` y deja estos en null.
  url       String?          @db.Text
  filename  String?
  embedUrl  String?          @db.Text
  text      String?          @db.Text
  /// Etiqueta de color libre (hex) — un punto en la esquina, sin semántica fija.
  color     String?
  notes     String?          @db.Text

  /// Formato de los elementos de texto. Va en columnas y no dentro del HTML
  /// de `text` a propósito: el sanitizador borra TODOS los atributos (ver
  /// sanitizeRichText en src/lib/dashboard/rich-text.ts), así que un
  /// style="" inline no sobreviviría. Aplican al bloque entero; el negrita/
  /// cursiva/listas sí es inline y vive en el HTML.
  fontSize  Int?
  textAlign String?
  textColor String?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([sessionId])
}

/// Suscripción de Web Push de un navegador/dispositivo (ver
/// src/lib/dashboard/notify-push.ts) — sin login de por medio, cualquiera
/// con sesión que active notificaciones queda suscripto desde ese browser.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  /// Quién se suscribió (ver src/app/api/push/subscribe/route.ts) — sabido
  /// desde siempre por la sesión en ese endpoint, pero recién ahora se
  /// guarda; hace falta para poder mandarle un push a una persona puntual
  /// (sendPushToEmail) en vez de a todos los suscriptos (sendPushToAll).
  /// Nullable: suscripciones creadas antes de este campo, o si el usuario
  /// se borra después (onDelete: SetNull, no se pierde la suscripción en sí).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

/// Alternativas de caption de una propuesta. El Editor/Admin puede cargar
/// varias y Jun (Comentarista) elige UNA — esa elección es la que se refleja
/// en Proposal.caption, que sigue siendo el caption "real" para el resto del
/// sistema (título, versiones, preview, notificaciones, export). Invariante:
/// como máximo una fila con selected = true por propuesta, y Proposal.caption
/// siempre es el texto de esa fila (ver syncSelectedCaption()).
model ProposalCaptionOption {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  text       String   @db.Text
  selected   Boolean  @default(false)
  /// Orden de presentación; se asigna por antigüedad al agregar.
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([proposalId])
}

/// Músicas de Instagram propuestas para el post — mismo patrón de selección
/// única que las alternativas de caption, pero acá "ninguna seleccionada" es
/// un estado válido (un post puede no llevar música). No hay espejo en
/// Proposal porque nada más en el sistema consume la música todavía.
model ProposalMusicOption {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// URL normalizada de instagram.com (ver normalizeInstagramMusicUrl) —
  /// opcional: una música puede cargarse solo con el archivo de audio, sin
  /// pasar por Instagram para nada (ver audioUrl más abajo). Vacía solo si
  /// audioUrl tiene algo; addMusicOption exige al menos uno de los dos.
  url        String?  @db.Text
  /// Nombre opcional que escribe quien la carga; si viene vacío la UI arma
  /// uno a partir de la URL.
  label      String?
  selected   Boolean  @default(false)
  order      Int      @default(0)
  /// Archivo de audio subido a Blob para poder escuchar la canción en el
  /// panel — Instagram no deja reproducir lo suyo afuera (ver
  /// instagramEmbedSrc), así que el único reproductor posible es uno servido
  /// desde acá. Opcional: la música vale igual con solo el enlace.
  audioUrl   String?  @db.Text
  /// Nombre original del archivo, para mostrarlo y para el botón de descarga.
  audioName  String?
  createdAt  DateTime @default(now())

  @@index([proposalId])
}

/// Galería de fotos independiente de las propuestas — pestaña propia al lado
/// de Feed, solo para subir y ver fotos, sin caption/fecha/aprobación. No se
/// relaciona con Proposal a propósito: es un depósito de material, no un
/// paso del flujo de aprobación (ver /galeria).
model GalleryPhoto {
  id         String   @id @default(cuid())
  url        String   @db.Text
  /// Nombre original del archivo, solo para mostrarlo.
  filename   String?
  /// Nombre o email de quien la subió — texto libre, no una relación a User,
  /// mismo criterio que ProposalComment.author (no hace falta más que eso).
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Repositorio de reels de Instagram para inspiración — pestaña propia a la
/// izquierda de Moodboard. Solo el permalink (post/reel); embedSrc se
/// deriva en el cliente con instagramEmbedSrc(), no se persiste (ver
/// /inspiracion).
model InspirationReel {
  id        String   @id @default(cuid())
  /// Permalink normalizado de instagram.com (ver normalizeInstagramMusicUrl)
  /// que además pasó instagramEmbedSrc() — un reel que no se puede embeber
  /// (página de audio, perfil) no se guarda acá, no serviría para nada.
  url       String   @db.Text
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Fotos de referencia, segunda sección de /inspiracion. Modelo aparte de
/// GalleryPhoto a propósito: la Galería es el depósito de material PROPIO
/// (fotos del restaurante), esto es referencia ajena que se mira para
/// inspirarse. Mezclarlas en una sola tabla obligaría a un discriminador y
/// a filtrar en cada consulta para separar dos cosas que nunca se listan
/// juntas.
model InspirationPhoto {
  id        String   @id @default(cuid())
  /// URL de Vercel Blob (ver assertBlobUrl) — la subida va directo del
  /// navegador a Blob, igual que los artes y la Galería.
  url       String   @db.Text
  /// Nombre original del archivo, solo para mostrarlo y para el alt.
  filename  String?
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
